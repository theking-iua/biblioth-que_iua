{
  "name": "pmb-iua-api",
  "version": "2.0.0",
  "private": true,
  "description": "API REST du SIGB PMB IUA — Node.js + Express + PostgreSQL (Neon)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:init": "node --env-file-if-exists=.env scripts/db-init.js",
    "db:demo": "node --env-file-if-exists=.env scripts/db-init.js --demo",
    "cron": "node --env-file-if-exists=.env scripts/cron.js",
    "import:lecteurs": "node --env-file-if-exists=.env scripts/import-lecteurs.js",
    "migrate:mysql": "node --env-file-if-exists=.env scripts/migrate-from-mysql.js",
    "test": "node --env-file-if-exists=.env --test test/*.test.js",
    "import:pmb": "node --env-file-if-exists=.env scripts/import-pmb.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1"
  },
  "optionalDependencies": {
    "mysql2": "^3.24.6"
  }
}
