# ======================================================================
#  API PMB IUA — configuration (copier ce fichier en .env et compléter)
# ======================================================================

# Chaîne de connexion Neon : console.neon.tech → votre projet → « Connect »
# (l'URL « pooled » ou directe fonctionne ; gardez ?sslmode=require)
DATABASE_URL=postgresql://utilisateur:motdepasse@ep-xxxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Secret de signature des sessions (64 caractères aléatoires). Pour en générer un :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Durée d'une session (secondes) — 12 h par défaut
JWT_TTL_SECONDS=43200

PORT=4000

# Fuseau horaire de la bibliothèque (dates des prêts, retards…)
APP_TIMEZONE=Africa/Abidjan

# Adresses des deux applis autorisées à appeler l'API (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# URL publique de l'API (liens des photos de profil)
PUBLIC_BASE_URL=http://localhost:4000/api

# Dossier des fichiers déposés (photos, PDF des mémoires)
UPLOAD_DIR=uploads

# Compte administrateur créé par « npm run db:init » (si absent)
ADMIN_EMAIL=iuapmb@iua.ci
ADMIN_PASSWORD=

# Traitement quotidien intégré au serveur (retards, suspensions, réservations expirées)
# Sinon : planifier « npm run cron » chaque nuit.
CRON_ENABLED=true
CRON_HOUR=2

# Connexion Microsoft 365 (facultatif)
SSO_ENABLED=false
SSO_CLIENT_ID=
SSO_TENANT_ID=common
SSO_ALLOWED_DOMAIN=iua.ci

# Migration depuis l'ancienne base MySQL (npm run migrate:mysql)
MYSQL_URL=mysql://root:@127.0.0.1:3306/iua_pmp
